# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# Auth0 management application (vault-secrets-broker-mgmt)
AUTH0_DOMAIN=your-tenant.au.auth0.com
AUTH0_MGMT_CLIENT_ID=your-mgmt-client-id
AUTH0_MGMT_CLIENT_SECRET=your-mgmt-client-secret
AUTH0_MGMT_AUDIENCE=https://your-tenant.au.auth0.com/api/v2/

# Auth0 application whose client_secret Vault will rotate (test-app-alpha)
AUTH0_TEST_APP_CLIENT_ID=your-test-app-client-id
