#!/usr/bin/env bash
# pre-push hook — runs local quality gates before any push.
# Install once with:  make hooks
#
# REQUIRED tools (push is blocked if missing):
#   govulncheck  — go install golang.org/x/vuln/cmd/govulncheck@v1.6.0
#
# OPTIONAL tools (push continues with a warning if missing):
#   golangci-lint — https://golangci-lint.run/welcome/install/

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
GO="${GO:-$(which go 2>/dev/null || echo go)}"
GOLANGCI="${GOLANGCI_LINT:-$(which golangci-lint 2>/dev/null || true)}"
GOVULNCHECK="${GOVULNCHECK:-$(which govulncheck 2>/dev/null || true)}"

MODULES=(
  "plugins/vault-rest-engine"
  "plugins/vault-auth0-engine"
  "cred-rotation-api"
)

RED='\033[0;31m'
YEL='\033[0;33m'
GRN='\033[0;32m'
NC='\033[0m'

fail() { echo -e "${RED}✖ $*${NC}" >&2; }
warn() { echo -e "${YEL}⚠ $*${NC}" >&2; }
ok()   { echo -e "${GRN}✔ $*${NC}"; }
info() { echo "  $*"; }

echo "=== pre-push: running local quality gates ==="

# ── 0. Require govulncheck ────────────────────────────────────────────────────
# Security dependency scanning is not optional — it is the primary reason this
# hook exists. Install it once and it runs in seconds.
if [[ -z "$GOVULNCHECK" ]]; then
  fail "govulncheck is not installed — push blocked."
  echo ""
  echo "  govulncheck scans for known CVEs in Go dependencies."
  echo "  Install it with:"
  echo "    go install golang.org/x/vuln/cmd/govulncheck@v1.6.0"
  echo ""
  echo "  Or run:  make install-tools"
  exit 1
fi

# ── 1. gofmt ──────────────────────────────────────────────────────────────────
echo
echo "→ gofmt"
UNFORMATTED=$(gofmt -l "$REPO_ROOT/plugins/" "$REPO_ROOT/cred-rotation-api/" 2>/dev/null || true)
if [[ -n "$UNFORMATTED" ]]; then
  fail "gofmt: the following files need formatting:"
  echo "$UNFORMATTED" | sed 's/^/    /'
  info "Fix with:  make fmt"
  exit 1
fi
ok "gofmt: all files formatted"

# ── 2. go vet (per module, skip if no packages) ────────────────────────────────
echo
echo "→ go vet"
VET_FAILED=0
for mod in "${MODULES[@]}"; do
  dir="$REPO_ROOT/$mod"
  if ! (cd "$dir" && "$GO" list ./... 2>/dev/null | grep -q .); then
    info "$mod: no packages — skipping"
    continue
  fi
  if ! (cd "$dir" && "$GO" vet ./... 2>&1); then
    fail "$mod: go vet failed"
    VET_FAILED=1
  else
    ok "$mod: go vet passed"
  fi
done
[[ $VET_FAILED -eq 0 ]] || exit 1

# ── 3. govulncheck (required — blocks push on any finding) ────────────────────
echo
echo "→ govulncheck"
VULN_FAILED=0
for mod in "${MODULES[@]}"; do
  dir="$REPO_ROOT/$mod"
  if ! (cd "$dir" && "$GO" list ./... 2>/dev/null | grep -q .); then
    info "$mod: no packages — skipping"
    continue
  fi
  if ! (cd "$dir" && "$GOVULNCHECK" ./... 2>&1); then
    fail "$mod: govulncheck found vulnerabilities — push blocked"
    VULN_FAILED=1
  else
    ok "$mod: govulncheck clean"
  fi
done
[[ $VULN_FAILED -eq 0 ]] || exit 1

# ── 4. golangci-lint (optional — warns if not installed) ──────────────────────
echo
echo "→ golangci-lint"
if [[ -z "$GOLANGCI" ]]; then
  warn "golangci-lint not found — skipping (install: https://golangci-lint.run/welcome/install/)"
else
  LINT_FAILED=0
  for mod in "${MODULES[@]}"; do
    dir="$REPO_ROOT/$mod"
    if ! (cd "$dir" && "$GO" list ./... 2>/dev/null | grep -q .); then
      info "$mod: no packages — skipping"
      continue
    fi
    if ! (cd "$dir" && "$GOLANGCI" run \
        --config "$REPO_ROOT/.golangci.yml" \
        --timeout 5m \
        ./... 2>&1); then
      fail "$mod: golangci-lint failed"
      LINT_FAILED=1
    else
      ok "$mod: golangci-lint passed"
    fi
  done
  [[ $LINT_FAILED -eq 0 ]] || exit 1
fi

echo
echo -e "${GRN}=== pre-push: all gates passed ===${NC}"
